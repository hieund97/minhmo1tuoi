{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "minhmo1tuoi",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-13",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/media/*", "/background_music.mp3"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "minhmo1tuoi-db",
      "database_id": "325aa21b-b7ce-468a-b2e4-77ded03609e5",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "minhmo1tuoi-media" }],
  "routes": [
    { "pattern": "minhmo1tuoi.online", "custom_domain": true }
  ],
  "workers_dev": true,
  "vars": { "TURNSTILE_SITE_KEY": "0x4AAAAAAF_dX58Oxj-yN7jM" },
  "observability": { "enabled": true }
}
